# This file applies to builds whose context is the repository root — that is,
# to the web image (frontend/Dockerfile). The api image has its own context,
# ./backend, and is filtered by backend/.dockerignore.

# Dependencies and artifacts are installed inside the image rather than
# shipped from the host: node_modules built on macOS simply won't run on linux.
node_modules/
dist/
.venv/
__pycache__/
.git/
.worktrees/
.env

# The backend and the docs are not part of the frontend image: all it needs
# from the root is exactly one file, the Caddyfile. Extra context means extra
# seconds on every build and another reason to rebuild a layer over an
# unrelated edit.
backend/
docs/
docker/
*.md
docker-compose*.yml

# The Vercel layout is the second deployment option and has nothing to do with
# the images: its own bridge to the backend and its own Python requirements.
api/
vercel.json
requirements.txt
