# Скопируй этот файл в .env в корне репозитория перед первым запуском
# приложения или тестов — app.config читает переменные оттуда (см.
# Settings.model_config в backend/app/config.py). DATABASE_URL, APP_SECRET и
# DIRECTOR_EMAIL обязательны и не имеют значения по умолчанию: без .env запуск
# честно упадёт с ошибкой pydantic вместо того, чтобы тихо уйти на посторонний
# сервер или остаться без директора.
#
# Тесты НЕ используют базу из DATABASE_URL напрямую. tests/conftest.py
# выводит из неё адрес базы «<имя>_test» (например, для planora — это
# planora_test) и только по ней делает drop_all/create_all. Эту базу
# нужно создать отдельно один раз, например:
#   docker compose exec db createdb -U planora planora_test
#
# Этот адрес — для запуска С ХОСТА (тесты, локальный uvicorn вне контейнера):
# Postgres публикуется наружу через DB_PORT, поэтому здесь localhost.
# Контейнер api под docker-compose получает СВОЙ собственный DATABASE_URL —
# он задан прямо в docker-compose.yml (сервис db, порт 5432 внутри сети
# compose) и переопределяет значение из этого файла. Не пытайся унифицировать
# оба адреса в одну переменную: у хоста и у контейнера api разное понятие
# «localhost», и один адрес не может быть верным для обоих одновременно.
DATABASE_URL=postgresql+psycopg://planora:planora@localhost:5432/planora
# Ключ подписи сессионных кук и шифрования ключей LLM. Значение ниже —
# заглушка: с ней (и с любым секретом короче 16 символов) приложение
# откажется стартовать. Сгенерируй своё: `openssl rand -hex 32`.
# Менять секрет на живой установке — не бесплатно: сохранённые ключи LLM
# зашифрованы прежним значением и после смены их придётся ввести заново.
APP_SECRET=change-me-to-a-long-random-string
# Единственный адрес, за которым закреплена роль директора — панели /admin
# (список регистраций, дата аккаунта и последняя активность каждого).
# Обязателен: значение ниже — заглушка, с ней (и с пустым значением)
# приложение откажется стартовать. Не роль в организации (владельцев
# организаций в установке может быть сколько угодно) — тот, кто эксплуатирует
# саму установку, не обязан состоять ни в одной из них. Смена директора —
# правка этой переменной и перезапуск, без изменений в коде.
DIRECTOR_EMAIL=change-me-to-your-email@example.com
# Порт, на котором Postgres публикуется на хост, и он же используется в
# DATABASE_URL выше. Переопредели оба вместе, если 5432 занят локальным
# Postgres. Действует только в режиме разработки (docker-compose.dev.yml):
# при обычном запуске база наружу не выходит вовсе. К адресу контейнера api
# (порт 5432 внутри сети compose) отношения не имеет ни в одном из режимов.
DB_PORT=5432
# Учётные данные сервиса db (docker-compose.yml). Обязательно смени на боевой
# установке и держи в синхроне с DATABASE_URL выше.
POSTGRES_USER=planora
POSTGRES_PASSWORD=planora
POSTGRES_DB=planora
# Порт, на котором интерфейс публикуется на хост, — единственный, который
# занимает обычный запуск. Меняется, если 8080 занят чем-то другим. Внутри
# сети compose порты фиксированы и от этой переменной не зависят: Caddy ходит
# в api:8000 в любом случае.
WEB_PORT=8080
# Флаг Secure сессионной куки. Обычно задавать не нужно: он выводится из
# схемы запроса (https или X-Forwarded-Proto от прокси) либо из
# PUBLIC_BASE_URL. Явное true/false — для установок, где автоматика
# ошибается, например когда TLS терминируется до прокси, который не
# передаёт X-Forwarded-Proto.
# COOKIE_SECURE=true
# Порт бэкенда на хосте. Как и DB_PORT, действует только в режиме разработки
# (docker-compose.dev.yml): при обычном запуске api наружу не выходит и
# доступен через WEB_PORT по адресам /api/*.
API_PORT=8000
# Адрес, из которого собираются ссылки-приглашения и публичные ссылки на
# проекты. Здесь стоит адрес обычного запуска — тот же, что и WEB_PORT ниже:
# скопированный файл должен работать без правки, а ссылка, ведущая на чужой
# домен, ломается молча — она открывается, просто не там. На своей установке
# замени на её домен; умолчание самого приложения (http://localhost:8000)
# указывает на бэкенд, наружу при обычном запуске не выходящий.
PUBLIC_BASE_URL=http://localhost:8080
DEFAULT_LOCALE=az
SUPPORTED_LOCALES=az,en,ru
# open (по умолчанию) — регистрация свободная; invite_only — только по
# приглашению; closed — вход есть, регистрации нет вовсе, даже по ссылке.
# Незнакомое значение приложение не стартует, а не молча закрывает установку.
SIGNUP_MODE=open
# Как отправлять письма: smtp / api / log / none.
# none (по умолчанию) — почты нет: приглашения работают, но только ссылкой для
# копирования, а письмо уходит в журнал приложения С ЗАМАСКИРОВАННЫМИ
# токенами: журнал боевой установки читают агрегаторы, и рабочая ссылка
# подтверждения в нём — готовый вход в чужой аккаунт.
# log — то же самое, но токены в журнале видны целиком (журнал и есть
# почтовый ящик при разработке), и интерфейс считает почту настроенной —
# показывает кнопку отправки. Для боевой установки log не годится.
# smtp / api — настоящая отправка. Приложение не стартует, если транспорт
# выбран, а нужные ему переменные ниже не заданы: иначе первое несостоявшееся
# письмо обнаружилось бы строчкой в логе, которую никто не читает.
MAIL_TRANSPORT=none
# Транспорт smtp: адрес, порт и учётные данные одной строкой. smtps:// — TLS с
# самого соединения (порт по умолчанию 465), smtp:// — обычное соединение с
# переходом на STARTTLS, если сервер его предлагает (порт 587). Пароль с
# символами @ / : кодируется процентами (%40, %2F, %3A). Пароль по
# незашифрованному каналу не передаётся вовсе — отправка отменяется.
# SMTP_URL=smtps://no-reply%40planora.example.com:pa%2Fssword@smtp.example.com:465
# Транспорт api: адрес и ключ рассылочного сервиса. Тело запроса —
# {from, to, subject, text}: форма Resend и совместимых с ним.
# MAIL_API_URL=https://api.resend.com/emails
# MAIL_API_KEY=
# Отправитель, от чьего имени уходят письма. Обязателен при smtp и api.
# MAIL_FROM=Planora <no-reply@planora.example.com>
# Срок жизни ссылки-приглашения и потолок приглашений в час на организацию.
# В потолок идут создание приглашения и отправка письма по нему; выпуск
# ссылки для копирования — нет, письма при нём не уходит.
INVITE_TTL_DAYS=7
INVITE_RATE_LIMIT=20
# Срок действия выгруженного документа (PDF/XLSX) в днях от даты выгрузки —
# «действительно до» на обложке. Один на всю установку.
EXPORT_VALIDITY_DAYS=30
# Публичные ссылки на проекты (/p/<организация>/<проект>?s=<токен>). false
# закрывает публикацию во всей установке: и выпуск новых ссылок, и уже
# выданные — настройка организации этот запрет не перебивает.
PUBLIC_SHARING_ENABLED=true
# Потолок гостевых комментариев в час с одного адреса. Предохранитель от
# заливки ленты, а не рубеж обороны: счётчик живёт в памяти процесса.
GUEST_COMMENT_RATE_LIMIT=10
# Потолок интервью, число повторов при битой схеме и таймаут запроса к модели.
# Ключ и адрес самой модели живут не здесь, а в настройках организации:
# ключ — на организацию и шифрованным.
# AI_MAX_QUESTIONS=12
# AI_SCHEMA_RETRIES=2
# AI_REQUEST_TIMEOUT=60
# Таймаут запроса к Jira и потолок задач, которые импорт/синхронизация
# обрабатывают за один вызов. Адрес сайта, email и API-токен живут не здесь,
# а в настройках организации — токен там же, шифрованным.
# JIRA_REQUEST_TIMEOUT=30
# JIRA_MAX_ISSUES_PER_SYNC=500
