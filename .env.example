# Copy this file to .env in the repository root before the first run of the
# application or the tests — app.config reads the variables from there (see
# Settings.model_config in backend/app/config.py). DATABASE_URL, APP_SECRET and
# DIRECTOR_EMAIL are mandatory and have no defaults: without .env the start-up
# fails honestly with a pydantic error instead of quietly wandering off to a
# stranger's server or running with no director at all.
#
# The tests do NOT use the database from DATABASE_URL directly.
# tests/conftest.py derives the address of a "<name>_test" database from it
# (for planora, that is planora_test) and only ever runs drop_all/create_all
# against that one. This database has to be created separately, once, e.g.:
#   docker compose exec db createdb -U planora planora_test
#
# This address is for running FROM THE HOST (tests, a local uvicorn outside the
# container): Postgres is published outward through DB_PORT, hence localhost
# here. The api container under docker-compose gets its OWN DATABASE_URL — it is
# set directly in docker-compose.yml (the db service, port 5432 inside the
# compose network) and overrides the value from this file. Do not try to unify
# the two addresses into a single variable: the host and the api container mean
# different things by "localhost", and one address cannot be right for both at
# once.
DATABASE_URL=postgresql+psycopg://planora:planora@localhost:5432/planora
# The key used to sign session cookies and encrypt LLM keys. The value below is
# a placeholder: with it (and with any secret shorter than 16 characters) the
# application refuses to start. Generate your own: `openssl rand -hex 32`.
# Changing the secret on a live installation is not free: stored LLM keys are
# encrypted with the previous value and will have to be entered again afterwards.
APP_SECRET=change-me-to-a-long-random-string
# The one address that holds the director role — the /admin panel (the list of
# registrations, each account's creation date and last activity). Mandatory: the
# value below is a placeholder, and with it (or with an empty value) the
# application refuses to start. Not a role within an organization (an
# installation may have any number of organization owners) — whoever operates
# the installation itself need not belong to any of them. Changing the director
# means editing this variable and restarting, with no code changes.
DIRECTOR_EMAIL=change-me-to-your-email@example.com
# The port on which Postgres is published to the host, and the same one used in
# DATABASE_URL above. Override both together if 5432 is taken by a local
# Postgres. It only applies in development mode (docker-compose.dev.yml): in a
# normal run the database is not exposed outward at all. It has nothing to do
# with the api container's address (port 5432 inside the compose network) in
# either mode.
DB_PORT=5432
# Credentials of the db service (docker-compose.yml). Be sure to change them on
# a production installation and keep them in sync with DATABASE_URL above.
POSTGRES_USER=planora
POSTGRES_PASSWORD=planora
POSTGRES_DB=planora
# The port on which the interface is published to the host — the only one a
# normal run occupies. Change it if 8080 is taken by something else. Inside the
# compose network the ports are fixed and do not depend on this variable: Caddy
# talks to api:8000 in any case.
WEB_PORT=8080
# The Secure flag of the session cookie. Usually there is no need to set it: it
# is derived from the request scheme (https, or X-Forwarded-Proto from the
# proxy) or from PUBLIC_BASE_URL. An explicit true/false is for installations
# where the automatic choice gets it wrong, for example when TLS is terminated
# ahead of a proxy that does not pass X-Forwarded-Proto on.
# COOKIE_SECURE=true
# The backend port on the host. Like DB_PORT, it only applies in development
# mode (docker-compose.dev.yml): in a normal run api is not exposed outward and
# is reachable through WEB_PORT at the /api/* addresses.
API_PORT=8000
# The address that invitation links and public project links are built from.
# What stands here is the address of a normal run — the same as WEB_PORT below:
# the copied file has to work without edits, and a link pointing at the wrong
# domain breaks silently — it opens, just not where it should. On your own
# installation replace it with its domain; the application's own default
# (http://localhost:8000) points at the backend, which a normal run does not
# expose outward.
PUBLIC_BASE_URL=http://localhost:8080
DEFAULT_LOCALE=az
SUPPORTED_LOCALES=az,en,ru
# open (the default) — registration is free; invite_only — by invitation only;
# closed — sign-in exists, registration does not at all, not even by link. On an
# unknown value the application refuses to start rather than quietly sealing the
# installation off.
SIGNUP_MODE=open
# How to send mail: smtp / api / log / none.
# none (the default) — there is no mail: invitations work, but only as a link to
# copy, while the message goes to the application log WITH THE TOKENS MASKED:
# the log of a production installation is read by aggregators, and a working
# confirmation link in it is a ready-made way into someone else's account.
# log — the same thing, but the tokens are visible in full in the log (in
# development the log is the mailbox), and the interface treats mail as
# configured — it shows the send button. log is unfit for production.
# smtp / api — real delivery. The application refuses to start if a transport is
# chosen while the variables it needs below are unset: otherwise the first
# undelivered message would surface as a line in a log nobody reads.
MAIL_TRANSPORT=none
# The smtp transport: host, port and credentials in one string. smtps:// — TLS
# from the connection itself (default port 465), smtp:// — a plain connection
# upgrading to STARTTLS if the server offers it (port 587). A password
# containing @ / : is percent-encoded (%40, %2F, %3A). A password is never sent
# over an unencrypted channel at all — the delivery is cancelled instead.
# SMTP_URL=smtps://no-reply%40planora.example.com:pa%2Fssword@smtp.example.com:465
# The api transport: the URL and key of a mail-delivery service. The request
# body is {from, to, subject, text}: the shape used by Resend and compatible
# services.
# MAIL_API_URL=https://api.resend.com/emails
# MAIL_API_KEY=
# The sender the messages go out as. Mandatory for smtp and api.
# MAIL_FROM=Planora <no-reply@planora.example.com>
# The lifetime of an invitation link and the hourly cap on invitations per
# organization. Creating an invitation and sending a message for it count
# towards the cap; issuing a link to copy does not, since no message is sent.
INVITE_TTL_DAYS=7
INVITE_RATE_LIMIT=20
# How long an exported document (PDF/XLSX) stays valid, in days from the export
# date — the "valid until" on the cover page. One value for the whole
# installation.
EXPORT_VALIDITY_DAYS=30
# Public project links (/p/<organization>/<project>?s=<token>). false shuts
# publishing down across the whole installation: both issuing new links and the
# ones already handed out — an organization setting does not override this ban.
PUBLIC_SHARING_ENABLED=true
# The hourly cap on guest comments from one address. A fuse against flooding the
# feed, not a line of defence: the counter lives in the process's memory.
GUEST_COMMENT_RATE_LIMIT=10
# The cap on interview questions, the number of retries on a malformed schema,
# and the request timeout for the model. The key and the model's own address do
# not live here but in the organization's settings: the key is per organization
# and encrypted.
# AI_MAX_QUESTIONS=12
# AI_SCHEMA_RETRIES=2
# AI_REQUEST_TIMEOUT=60
# The request timeout for Jira and the cap on issues that an import or a sync
# handles in a single call. The site address, the email and the API token do not
# live here but in the organization's settings — the token there is encrypted
# too.
# JIRA_REQUEST_TIMEOUT=30
# JIRA_MAX_ISSUES_PER_SYNC=500
