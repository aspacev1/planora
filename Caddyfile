# From the outside the site is reachable on 80/443 — Docker publishes those on
# the host (see docker-compose.yml, the web service), forwarding to the high
# ports below. Caddy cannot and must not bind 80/443 itself: inside the
# container it runs as a non-root user with no capabilities at all (USER web,
# cap_drop: ALL). Spelling the ports out is required, otherwise Caddy assumes
# that it is 8080/8443 from the outside too, and serves the ACME domain
# challenge and the http-to-https redirect on the wrong ports.
{
	http_port 8080
	https_port 8443
}

pm.datanova.az {
	encode gzip

	# Security headers — on every response, both static files and the API.
	header {
		# The browser is forbidden to sniff a file's type: a guessed "HTML"
		# inside user-uploaded content is XSS out of thin air.
		X-Content-Type-Options nosniff
		# The page must not be shown in another site's frame: clickjacking
		# protection. Two headers: CSP for modern browsers, X-Frame-Options
		# for those that do not read CSP.
		X-Frame-Options DENY
		# Project addresses must not leak into the Referer of foreign sites via
		# links in comments: the slug is part of the secret public link.
		Referrer-Policy strict-origin-when-cross-origin
		# Scripts and requests — same origin only. style-src carries
		# 'unsafe-inline' deliberately: the interface lays the chart out with
		# inline styles (bar widths), and without it the Gantt is blind.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# HSTS only takes effect over HTTPS; over plain HTTP the browser
		# ignores it, so sending it unconditionally is safe.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The server version is not advertised outward.
		-Server
	}

	# The API is matched before files. The order is not cosmetic: the fallback
	# to index.html sits below, and it would catch /api/nonexistent first,
	# handing the client HTML instead of the server's answer.
	handle /api/* {
		# X-Forwarded-For is overwritten with the client's real address rather
		# than appended to: a value arriving from outside is a string from
		# anyone at all, and the application counts login and guest-comment
		# rate limits by this header. Keeping a foreign value would mean
		# letting the limit be bypassed by changing a header.
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		# Routes live on the client and there are no files behind them: without
		# the fallback, reloading the page at /projects yields a 404 from Caddy
		# even though that address exists inside the application.
		try_files {path} /index.html
		file_server
	}
}
